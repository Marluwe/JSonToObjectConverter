<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JsonToObjectConverter</PackageId>
    <Version>0.1.0</Version>
    <Authors>JsonToObjectConverter Contributors</Authors>
    <Description>Core library with attributes for JSON serialization via source generation</Description>
    <PackageTags>json;serialization;source-generator;performance</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yourusername/JsonToObjectConverter</RepositoryUrl>
  </PropertyGroup>

</Project>
